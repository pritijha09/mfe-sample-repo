{
  "name": "mfe-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:shell": "ng build shell-app --configuration production",
    "build:home": "ng build home-mf --configuration production",
    "build:checkout": "ng build checkout-mfe --configuration production",
    "build:products": "ng build products-mf --configuration production",
    "build:cart": "ng build cart-mf --configuration production",
    "build:orders": "ng build orders-mfe --configuration production",
    "build:profile": "ng build profile-mf --configuration production",
    "build:auth": "ng build auth-mfe --configuration production",
    "build:admin": "ng build admin-mf --configuration production",
    "start:shell": "ng serve shell-app --port 4200",
    "start:products": "ng serve products-mf --port 4201",
    "start:auth": "ng serve auth-mfe --port 4202",
    "start:home": "ng serve home-mf --port 4204",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular-architects/native-federation": "^21.2.3",
